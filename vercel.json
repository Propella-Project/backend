{
  "builds": [
    {
      "src": "config/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "buildCommand": "bash build.sh"
      }
    }
  ],
  "routes": [

    {
      "src": "/(.*)",
      "dest": "config/wsgi.py",
      "headers": {
        "Cache-Control": "public, max-age=3600"
      }
    }
  ]
}
