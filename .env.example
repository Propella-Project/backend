# =====================================================
# Propella API — Environment Configuration Example
# =====================================================
# Copy this file to .env and fill in your actual values
# For development, most defaults are safe; for production, 
# configure all variables explicitly.

# =====================================================
# DJANGO CORE
# =====================================================
# Secret key for Django. Generate a new one for production:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-very-long-secret-key-here-change-in-production

# Enable/disable debug mode (set to False in production)
DEBUG=True

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1,example.com

# Set to True to enforce full security (SSL redirect, strict cookies, etc.)
# when running locally. Only recommended if using HTTPS dev server.
ENFORCE_SECURITY=False

# =====================================================
# DATABASE
# =====================================================
# Database engine: 'django.db.backends.postgresql' or 'django.db.backends.sqlite3'
DB_ENGINE=django.db.backends.postgresql

# Database name
DB_NAME=propella_db
DATABASE=propella_db

# Database user
DB_USER=postgres
USER=postgres

# Database password
DB_PASSWORD=your-db-password

# Database host (leave empty to use Unix socket, or 'localhost' for TCP)
DB_HOST=localhost
HOST=localhost

# Database port
DB_PORT=5432
PORT=5432

# =====================================================
# AWS / S3 STORAGE (Supabase S3 or other S3-compatible)
# =====================================================
# AWS/S3 access key ID
AWS_ACCESS_KEY_ID=your-access-key-id

# AWS/S3 secret access key
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# S3 bucket name (optional — used for media storage)
AWS_STORAGE_BUCKET_NAME=your-bucket-name

# S3 region
AWS_S3_REGION_NAME=us-east-1

# S3 endpoint URL (for Supabase or other S3-compatible services)
# Example: https://duvupolpkzuaqsmhflaw.supabase.co/storage/v1/s3
AWS_S3_ENDPOINT_URL=https://your-s3-endpoint.example.com/storage/v1/s3

# =====================================================
# SUPABASE
# =====================================================
# Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase service role key (for server-side operations)
SUPABASE_SERVICE_KEY=your-supabase-service-key

# Supabase bucket name for file storage
SUPABASE_BUCKET=media

# =====================================================
# EMAIL (optional)
# =====================================================
# Email backend: 'django.core.mail.backends.console.EmailBackend' for development
# or 'django.core.mail.backends.smtp.EmailBackend' for production
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP host
EMAIL_HOST=smtp.example.com

# SMTP port (usually 587 for TLS, 465 for SSL, 25 for unencrypted)
EMAIL_PORT=587

# Use TLS for SMTP connection (True or False)
EMAIL_USE_TLS=True

# SMTP username
EMAIL_HOST_USER=your-email@example.com

# SMTP password
EMAIL_HOST_PASSWORD=your-email-password

# Default "from" email address
DEFAULT_FROM_EMAIL=noreply@propella.com

# =====================================================
# DEPLOYMENT / VERCEL
# =====================================================
# Custom domain (optional, used by CORS settings)
CUSTOM_DOMAIN=propella.example.com

# Vercel deployment URL (automatically set by Vercel)
VERCEL_URL=your-vercel-deployment.vercel.app

# =====================================================
# DEVELOPMENT NOTES
# =====================================================
# DEBUG=True   : Enable for development; set to False in production
# DB_ENGINE    : Use 'django.db.backends.postgresql' for production,
#                'django.db.backends.sqlite3' for local/testing
# AWS_*        : Required if using S3 storage; otherwise optional
# SUPABASE_*   : Required if using Supabase; test locally without it
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-password
DEFAULT_FROM_EMAIL=noreply@propella.com